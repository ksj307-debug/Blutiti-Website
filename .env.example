# 카카오디벨로퍼스 [앱] > [앱 키] 의 JavaScript 키 (카카오톡 채널 1:1 채팅 버튼용)
# 이 파일을 .env.local 로 복사해 값을 넣고, [앱] > [플랫폼] > Web 에 사이트 도메인을 등록하세요
# 비워 두면 '카카오톡 문의' 버튼은 채널 채팅 주소(pf.kakao.com/_VexnFn/chat)를 새 창으로 엽니다
NEXT_PUBLIC_KAKAO_JS_KEY=

# 네이버 클라우드 플랫폼 > Maps > Application 의 인증 정보 (LOCATION 지도)
# Client ID: 브라우저 지도 표시용. Application 의 Web 서비스 URL 에 사이트 주소를 등록하세요
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
# Client Secret: 매장 좌표 1회 조회(Geocoding)용. 조회가 끝나면 비워도 됩니다. 화면 코드에서 쓰지 않음
NAVER_MAP_CLIENT_SECRET=
